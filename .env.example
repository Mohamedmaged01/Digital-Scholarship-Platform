# ============================================================================
#  The Custodian of the Two Holy Mosques Scholarship Program
#  Unified Digital Scholarship Platform - Laravel / Blade
# ============================================================================
APP_NAME="برنامج خادم الحرمين الشريفين للابتعاث"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Arabic (RTL) is the primary language of the portal; English is fully supported.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Database - SQLite works out of the box. For MySQL / PostgreSQL, switch
# DB_CONNECTION and fill in the credentials below.
# ----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kasp_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="scholarship@moe.gov.sa"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Scholarship platform settings
# ----------------------------------------------------------------------------
# Official Ministry of Education application portal (all applications happen there).
KASP_APPLY_URL=https://kasp.moe.gov.sa
KASP_MOE_URL=https://moe.gov.sa
KASP_VISION_URL=https://www.vision2030.gov.sa
KASP_SUPPORT_PHONE=19996
KASP_SUPPORT_EMAIL=scholarship@moe.gov.sa

# ----------------------------------------------------------------------------
# AI advisor. Leave GEMINI_API_KEY empty to use the built-in rule-based
# scholarship knowledge engine only (no external calls are made).
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ASSISTANT_DRIVER=engine
