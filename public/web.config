<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS front-controller rules.

    The Apache equivalent of this file is public/.htaccess. Both live here because
    the platform is deployed to Plesk on Windows/IIS as well as to Linux hosts;
    each web server reads only its own file and ignores the other.

    The site's document root must point at this directory, not at the repository
    root — everything above public/ (including .env) must stay unreachable.
-->
<configuration>
    <system.webServer>

        <rewrite>
            <rules>
                <!-- Strip a trailing slash from anything that is not a real directory. -->
                <rule name="Laravel: remove trailing slash" stopProcessing="true">
                    <match url="^(.*)/$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
                </rule>

                <!-- Send everything that is not an existing file or directory to index.php. -->
                <rule name="Laravel: front controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <!-- Belt and braces: refuse dotfiles even if the document root is misconfigured. -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment=".git" />
                    <add segment="storage" />
                    <add segment="vendor" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <staticContent>
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>

    </system.webServer>
</configuration>
